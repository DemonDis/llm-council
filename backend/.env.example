# Ключ API
OPENROUTER_API_KEY=sk-...

# Конечная точка API
OPENROUTER_API_URL=

# Члены совета — список идентификаторов моделей OpenRouter через запятую
COUNCIL_MODELS=Deepseek/DeepSeek-V4-Flash-0731,Qwen/Qwen3.6-27B-FP8,Qwen/Qwen3.5-4B

# Модель председателя — синтезирует итоговый ответ
CHAIRMAN_MODEL=Deepseek/DeepSeek-V4-Flash-0731

# Модель для ролевого режима — отвечает от лица всех ролей совета
ROLEPLAY_MODEL=Deepseek/DeepSeek-V4-Flash-0731

# Модель для генерации заголовков разговоров 
TITLE_MODEL=Deepseek/DeepSeek-V4-Flash-0731

# Каталог для хранения разговоров
DATA_DIR=data/conversations
# Каталог логов запросов/ответов к LLM (относительные пути — от backend/)
LOGS_DIR=data/logs

# Логирование вызовов LLM: true / false
LLM_LOGS_ENABLED=true
