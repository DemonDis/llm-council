# Базовый образ
FROM node:22-alpine

RUN --mount=type=bind,source=./,target=/distr/ \
   cd /distr \
&& mkdir /app \
&& cp -r package*.json vite.config.js index.html run.sh \
   node_modules src public /app
   
# Рабочая директория
WORKDIR /app

# Открываем порт для разработки
EXPOSE 5173

# Команда для запуска сервера разработки (Vite)
CMD ["npm", "run", "dev", "--", "--host"]
